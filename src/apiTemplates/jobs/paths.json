{
  "/jobs": {
    "post": {
      "description": "Create a new job (potentially pending execution).",
      "operationId": "postJobs",
      "tags": ["Processes Part 4: Job Management"],
      "responses": {
        "200": {
          "description": "The operation was executed successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Process"
              }
            },
            "text/html": {
              "schema": {
                "$ref": "#/components/schemas/htmlSchema"
              }
            }
          }
        },
        "404": {
          "$ref": "https://schemas.opengis.net/ogcapi/processes/part1/1.0/openapi/responses/NotFound.yaml"
        },
        "410": {
          "description": "The job has been dismissed"
        }
      }
    },
    "get": {
      "tags": ["Processes Part 1: Core"],
      "description": "Retrieve a list of jobs",
      "operationId": "getJobs",
      "parameters": [
        { "$ref": "#/components/parameters/fJob" },
        { "$ref": "#/components/parameters/typeJobs" },
        { "$ref": "#/components/parameters/processIDJobs" },
        { "$ref": "#/components/parameters/statusJobs" },
        { "$ref": "#/components/parameters/datetimeJobs" },
        { "$ref": "#/components/parameters/minDurationJobs" },
        { "$ref": "#/components/parameters/maxDurationJobs" },
        { "$ref": "#/components/parameters/limitJobs" },
        { "$ref": "#/components/parameters/offsetJobs" }
      ],
      "responses": {
        "200": {
          "description": "The operation was executed successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Jobs"
              }
            },
            "text/html": {
              "schema": {
                "$ref": "#/components/schemas/htmlSchema"
              }
            }
          }
        },
        "404": {
          "$ref": "https://schemas.opengis.net/ogcapi/processes/part1/1.0/openapi/responses/NotFound.yaml"
        }
      },
      "summary": "Retrieve jobs list"
    }
  },
  "/jobs/{jobId}": {
    "delete": {
      "description": "Cancel / delete job",
      "operationId": "deleteJob",
      "parameters": [
        {
          "description": "job identifier",
          "in": "path",
          "name": "jobId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The operation was executed successfully.",
