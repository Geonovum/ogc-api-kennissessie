            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Process"
              }
            },
            "text/html": {
              "schema": {
                "$ref": "#/components/schemas/htmlSchema"
              }
            }
          }
        },
        "404": {
          "$ref": "https://schemas.opengis.net/ogcapi/processes/part1/1.0/openapi/responses/NotFound.yaml"
        },
        "410": {
          "description": "The job has been dismissed"
        }
      },
      "summary": "Cancel / delete job",
      "tags": ["Processes Part 1: Core"]
    },
    "patch": {
      "description": "Update an existing job (if pending execution).",
      "operationId": "patchJob",
      "tags": ["Processes Part 4: Job Management"],
      "parameters": [
        {
          "description": "job identifier",
          "in": "path",
          "name": "jobId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The operation was executed successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Process"
              }
            },
            "text/html": {
              "schema": {
                "$ref": "#/components/schemas/htmlSchema"
              }
            }
          }
        },
        "404": {
          "$ref": "https://schemas.opengis.net/ogcapi/processes/part1/1.0/openapi/responses/NotFound.yaml"
        },
        "410": {
          "description": "The job has been dismissed"
        }
      }
    },
    "get": {
      "description": "Retrieve job details",
      "operationId": "getJob",
      "parameters": [
        {
          "description": "job identifier",
          "in": "path",
          "name": "jobId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "$ref": "#/components/parameters/fJob"
        }
      ],
      "responses": {
        "200": {
          "description": "The operation was executed successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusInfo"
              }
            },
            "text/html": {
              "schema": {
                "$ref": "#/components/schemas/htmlSchema"
              }
            }
          }
        },
        "404": {
          "description": "The job identifier does not exist.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/opengeospatial/ogcapi-processes/master/openapi/schemas/common-core/exception.yaml"
              }
            }
          }
        },
        "410": {
          "description": "The job has been dismissed"
        }
      },
      "summary": "Retrieve job details",
      "tags": ["Processes Part 1: Core"]
    }
  },
  "/jobs/{jobId}/results": {
    "get": {
      "description": "Retrieve job results",
      "operationId": "getJobResults",
      "parameters": [
        {
          "description": "job identifier",
          "in": "path",
          "name": "jobId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "$ref": "#/components/parameters/fResults"
        },
        {
          "$ref": "#/components/parameters/outputsResults"
        }
      ],
      "responses": {
        "200": {
          "description": "The operation was executed successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Results"
              }
            },
            "text/html": {
              "schema": {
                "$ref": "#/components/schemas/htmlSchema"
              }
            }
          }
        },
        "400": {
          "description": "Invalid query parameter value or unknown output identifier.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/opengeospatial/ogcapi-processes/master/openapi/schemas/common-core/exception.yaml"
              }
            }
          }
        },
        "404": {
          "description": "The job does not exist, is still running, or no outputs are available.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/opengeospatial/ogcapi-processes/master/openapi/schemas/common-core/exception.yaml"
              }
            }
          }
        },
        "410": {
          "description": "The job has been dismissed"
        },
        "500": {
          "description": "The job failed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/opengeospatial/ogcapi-processes/master/openapi/schemas/common-core/exception.yaml"
              }
            }
          }
        }
      },
      "summary": "Retrieve job results",
      "tags": ["Processes Part 1: Core"]
    }
  },
