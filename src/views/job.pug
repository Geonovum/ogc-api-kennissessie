extends layout.pug

block header

  svg.d-none(xmlns='http://www.w3.org/2000/svg')
    symbol#house-door-fill(viewbox='0 0 16 16')
      path(d='M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5z')

  - let linkSelf = content.links.find(i => i.rel == 'self').href.split('?')[0]
  - let links = [ linkSelf ]
  - while (links[0] != serviceUrl) {
  -   links.unshift(links[0].substr(0, links[0].lastIndexOf("/"))) }

  nav.navbar.navbar-light.bg-light.navbar-expand-sm
    .container
      #navbar.navbar-collapse.collapse.d-flex.justify-content-between.align-items-center
        ol.breadcrumb.breadcrumb-chevron.p-3.bg-light
          li.breadcrumb-item
            a.link-body-emphasis(href=serviceUrl)
              svg.bi(width='16' height='16')
                use(xlink:href='#house-door-fill')
              span.visually-hidden serviceUrl
          li.breadcrumb-item
            a.link-body-emphasis.fw-semibold.text-decoration-none(href=links[1]) Jobs
          - let pathElement = links[2].substring(links[2].lastIndexOf("/") + 1);
          li.breadcrumb-item.active(aria-current='page')
            | #{pathElement}
        ul.list-separated.m-0.p-0
          a(href=linkSelf + '?f=json') JSON

block content

  .container
    .row
      .col-sm-12
        br
        section#job
          .row.align-items-center
            .col
              h1 Job status
            .col-auto
              button#dismiss-job.btn.btn-outline-danger(type='button') Dismiss
          p#dismiss-result.small.text-danger
          .row
            .col-md-12
              #job-status.successful
                #job-status-header.successful
                  p Status: #{content.status}
                #job-status-body
                  .message
                    h3 Message
                    p #{content.message}
                  .duration
                    - const date1 = new Date(content.started);
                    - const date2 = new Date(content.finished);
                    - const diffTime = Math.abs(date2 - date1);
                    h4
                      label(for='progress') Progress
                    progress#progress.inline(value=content.progress max='100')
                    h4
                      label(for='runtime') Duration
                    p
                      span#runtime
                        | #{diffTime}ms
                    h4
                      label(for='starttime') Started processing
                    p
                      span#starttime #{content.started}
                    h4
                      label(for='endtime') Finished processing
                    p
                      span#endtime #{content.finished}
                    h3 Links
                    - var linkJson = content.links.find(i => i.rel == 'http://www.opengis.net/def/rel/ogc/1.0/results' && i.type == 'application/json').href
                    ul
                      li
                        a(href=linkJson)
                          span Results of job as JSON
                          |  (
                          span application/json
                          | )

  script.
    const jobUrl = !{JSON.stringify(linkSelf)};
    const jobStatus = !{JSON.stringify(content.status)};
    // (OAPIP) StatusInfo: accepted/running are in-progress; successful/failed/dismissed are terminal
    const jobDone = ['successful', 'failed', 'dismissed'].includes(jobStatus);
    let refreshTimer;
    if (!jobDone) {
      refreshTimer = window.setTimeout(function () {
        window.location.reload();
      }, 2000);
    }

    const dismissButton = document.getElementById('dismiss-job');
    const dismissResult = document.getElementById('dismiss-result');
    if (dismissButton) {
      dismissButton.addEventListener('click', async function () {
        if (!window.confirm('Dismiss this job? Running work will be cancelled.'))
          return;
        dismissButton.disabled = true;
        dismissResult.textContent = '';
        try {
          const response = await fetch(jobUrl, {
            method: 'DELETE',
            headers: { Accept: 'application/json' }
          });
          const text = await response.text();
          let payload = text;
          try { payload = text ? JSON.parse(text) : {}; } catch (err) { /* keep text */ }

          if (response.status === 200) {
            if (refreshTimer) window.clearTimeout(refreshTimer);
            const statusEl = document.querySelector('#job-status-header p');
            if (statusEl)
              statusEl.textContent = 'Status: ' + (payload.status || 'dismissed');
            const messageEl = document.querySelector('#job-status-body .message p');
            if (messageEl)
              messageEl.textContent = payload.message || 'Job dismissed';
            dismissButton.remove();
            return;
          }

          dismissResult.textContent =
            payload.detail || payload.title || ('HTTP ' + response.status);
          dismissButton.disabled = false;
        } catch (err) {
          dismissResult.textContent = String(err);
          dismissButton.disabled = false;
        }
      });
    }