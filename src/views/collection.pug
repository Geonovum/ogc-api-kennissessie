extends layout.pug

block append scripts
  link(rel='stylesheet' href='https://unpkg.com/leaflet@1.6.0/dist/leaflet.css')
  script(src='https://unpkg.com/leaflet@1.6.0/dist/leaflet.js')
  style.
    #collection-map {
      height: 400px;
      width: 100%;
    }
    .keyword-badge {
      font-size: 0.95rem;
      padding: 0.4em 0.75em;
    }

block header

  svg.d-none(xmlns='http://www.w3.org/2000/svg')
    symbol#house-door-fill(viewbox='0 0 16 16')
      path(d='M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5z')

  - let linkSelf = content.links.find(i => i.rel == 'self').href.split('?')[0]
  - let links = [ linkSelf ]
  - while (links[0] != serviceUrl) {
  -  links.unshift(links[0].substr(0, links[0].lastIndexOf("/"))) }

  nav.navbar.navbar-light.bg-light.navbar-expand-sm
    .container
      #navbar.navbar-collapse.collapse.d-flex.justify-content-between.align-items-center
        ol.breadcrumb.breadcrumb-chevron.p-3.bg-light
          li.breadcrumb-item
            a.link-body-emphasis(href=serviceUrl)
              svg.bi(width='16' height='16')
                use(xlink:href='#house-door-fill')
              span.visually-hidden serviceUrl
          li.breadcrumb-item
            a.link-body-emphasis.fw-semibold.text-decoration-none(href=links[1]) Collections
          - let pathElement = linkSelf.substring(linkSelf.lastIndexOf("/") + 1);
          li.breadcrumb-item.active(aria-current='page')
            | #{pathElement}
        ul.list-separated.m-0.p-0
          a(href=linkSelf + '?f=json') JSON

block content

  .container
    section#collection
      .row.align-items-center
        .col
          h1 #{content.title}
        .col-auto
          button#delete-collection.btn.btn-outline-danger(type='button') Delete collection
      p#delete-result.small.text-danger
      p #{content.description}
      if content.keywords && content.keywords.length
        p
          each keyword in content.keywords
            span.badge.keyword-badge.text-bg-primary.bg-primary.me-1 #{keyword}

      .row
        .col-sm-12.mb-2
          #collection-map
          script.
            const coords = !{JSON.stringify(content.extent.spatial.bbox)}
            const bounds = [[coords[1], coords[0]], [coords[3], coords[2]]];
            const map = L.map("collection-map");
            L.tileLayer(
              'https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/pastel/EPSG:3857/{z}/{x}/{y}.png',
              {
                attribution:
                  'Kaartgegevens &copy; <a href="https://www.kadaster.nl">Kadaster</a> | <a href="https://www.verbeterdekaart.nl">Verbeter de kaart</a>',
                minZoom: 6,
                maxZoom: 19
              }
            ).addTo(map);
            L.rectangle(bounds).addTo(map);
            map.fitBounds(bounds, {maxZoom: 10});

      - var linkItems = linkSelf + '/items'
      - var linkQueryables = linkSelf + '/queryables'
      - var linkSchema = linkSelf + '/schema'

      h3 Browse
      ul
        li
          div
            a(title='Browse Items' href=linkItems)
              | Browse through the items of "#{content.title}"

      h3 Queryables
      ul
        li
          div
            a(title='Display Queryables' href=linkQueryables)
              | Display Queryables of "#{content.title}"

      h3 Schema
      ul
        li
          div
            a(title='Display Schema' href=linkSchema)
              | Display Schema of "#{content.title}"

      h3 Links
      ul
        each link in content.links
          li
            a(title=link.rel href=link.href)
              span #{link.title}
              |  (
              span #{link.type}
              | )

      if content.crs && content.crs.length
        h3 Reference Systems
        ul
          each crs in content.crs
            li
              a(title=crs href=crs)
                span #{crs}

      if content.storageCrs
        h3 Storage CRS
        ul
          li
            | CRS: 
            a(title=content.storageCrs href=content.storageCrs)
              span #{content.storageCrs}
          li
            | Epoch: 
            span _(not specified)

  script.
    const collectionUrl = !{JSON.stringify(linkSelf)};
    const collectionsUrl = !{JSON.stringify(links[1])};
    const deleteButton = document.getElementById('delete-collection');
    const deleteResult = document.getElementById('delete-result');
    if (deleteButton) {
      deleteButton.addEventListener('click', async function () {
        if (!window.confirm('Delete this collection and its GeoJSON file?'))
          return;
        deleteButton.disabled = true;
        deleteResult.textContent = '';
        try {
          const response = await fetch(collectionUrl, {
            method: 'DELETE',
            headers: { Accept: 'application/json' }
          });
          const text = await response.text();
          let payload = text;
          try { payload = text ? JSON.parse(text) : {}; } catch (err) { /* keep text */ }

          if (response.status === 204 || response.status === 200) {
            window.location.href = collectionsUrl;
            return;
          }

          deleteResult.textContent =
            payload.description || payload.detail || ('HTTP ' + response.status);
          deleteButton.disabled = false;
        } catch (err) {
          deleteResult.textContent = String(err);
          deleteButton.disabled = false;
        }
      });
    }
