extends layout.pug

block append scripts
  link(rel='stylesheet' href='https://unpkg.com/leaflet@1.6.0/dist/leaflet.css')
  link(rel='stylesheet' href='https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css')
  link(rel='stylesheet' href='https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css')
  script(src='https://unpkg.com/leaflet@1.6.0/dist/leaflet.js')
  script(src='https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js')
  style.
    #items-map {
      height: 400px;
      width: 100%;
    }

block header

  svg.d-none(xmlns='http://www.w3.org/2000/svg')
    symbol#house-door-fill(viewbox='0 0 16 16')
      path(d='M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5z')

  - let linkSelf = content.links.find(i => i.rel == 'self').href.split('?')[0]
  - let links = [ linkSelf ]
  - while (links[0] != serviceUrl) {
  -  links.unshift(links[0].substr(0, links[0].lastIndexOf("/"))) }

  nav.navbar.navbar-light.bg-light.navbar-expand-sm
    .container
      #navbar.navbar-collapse.collapse.d-flex.justify-content-between.align-items-center
        ol.breadcrumb.breadcrumb-chevron.p-3.bg-light
          li.breadcrumb-item
            a.link-body-emphasis(href=serviceUrl)
              svg.bi(width='16' height='16')
                use(xlink:href='#house-door-fill')
              span.visually-hidden serviceUrl
          li.breadcrumb-item
            a.link-body-emphasis.fw-semibold.text-decoration-none(href=links[1]) Collections
          - let pathElement = links[2].substring(links[2].lastIndexOf("/") + 1);
          li.breadcrumb-item
            a.link-body-emphasis.fw-semibold.text-decoration-none(href=links[2]) #{pathElement}
          li.breadcrumb-item.active(aria-current='page')
            | Items
        ul.list-separated.m-0.p-0
          a(href=linkSelf + '?f=json') JSON

block content

  -
    function truncate(value, length) {
      if (value === undefined || value === null) return '';
      var text = String(value);
      if (text.length <= length) return text;
      return text.substring(0, length) + '...';
    }
    var skipKeys = ['id', 'fid', 'ID', 'gml_id', 'objectid', 'OBJECTID'];
    var propertyKeys = [];
    if (content.features && content.features.length && content.features[0].properties)
      propertyKeys = Object.keys(content.features[0].properties).filter((key) => !skipKeys.includes(key));
    var firstLink = content.links.find((link) => link.rel == 'first');
    var prevLink = content.links.find((link) => link.rel == 'prev');
    var nextLink = content.links.find((link) => link.rel == 'next');
    var lastLink = content.links.find((link) => link.rel == 'last');
    var selfLink = content.links.find((link) => link.rel == 'self');
    var selfUrl = selfLink ? new URL(selfLink.href) : null;
    var currentOffset = selfUrl ? (parseInt(selfUrl.searchParams.get('offset')) || 0) : 0;
    var currentLimit = selfUrl ? (parseInt(selfUrl.searchParams.get('limit')) || 10) : 10;
    var currentPage = Math.floor(currentOffset / currentLimit) + 1;
    var totalPages = currentLimit ? Math.ceil((content.numberMatched || 0) / currentLimit) : 1;
    var startPage = Math.max(1, currentPage - 2);
    var endPage = Math.min(totalPages, currentPage + 2);

  .container
    section#collection
      h1 #{content.title}
    section#items
      if content.features && content.features.length
        .row
          .col-sm-12.col-md-6
            .row
              .col-sm-12
                #items-map
            .row
              .col-sm-12
                if content.numberMatched !== undefined
                  p Items in this collection: #{content.numberMatched}
            if totalPages > 1
              .row
                .col-sm-12
                  nav(aria-label='Pagination')
                    ul.pagination.mb-2.flex-wrap
                      if firstLink
                        li.page-item
                          a.page-link(href=firstLink.href title=firstLink.title) first
                      else
                        li.page-item.disabled
                          span.page-link first
                      if prevLink
                        li.page-item
                          a.page-link(href=prevLink.href title=prevLink.title) prev
                      else
                        li.page-item.disabled
                          span.page-link prev
                      - var p = startPage
                      while p <= endPage
                        if p == currentPage
                          li.page-item.active
                            span.page-link #{p}
                        else
                          - var pageUrl = new URL(selfUrl.toString())
                          - pageUrl.searchParams.set('offset', (p - 1) * currentLimit)
                          li.page-item
                            a.page-link(href=pageUrl.toString()) #{p}
                        - p++
                      if nextLink
                        li.page-item
                          a.page-link(href=nextLink.href title=nextLink.title) next
                      else
                        li.page-item.disabled
                          span.page-link next
                      if lastLink
                        li.page-item
                          a.page-link(href=lastLink.href title=lastLink.title) last
                      else
                        li.page-item.disabled
                          span.page-link last

          .col-sm-12.col-md-6(style='overflow-x: scroll;')
            table.table.table-striped.table-bordered
              thead
                tr
                  th id
                  each key in propertyKeys
                    th #{key}
              tbody
                each feature in content.features
                  - var featureId = feature.id !== undefined ? feature.id : (feature.properties && feature.properties.fid)
                  tr
                    td(data-label='id')
                      a(href=linkSelf + '/' + encodeURIComponent(featureId) title=featureId) #{truncate(featureId, 12)}
                    each key in propertyKeys
                      td(data-label=key) #{truncate(feature.properties ? feature.properties[key] : '', 35)}
      else if content.numberMatched
        p Items in this collection: #{content.numberMatched}
      else
        p No items

  if content.features && content.features.length
    script.
      const itemsPath = !{JSON.stringify(linkSelf)};
      const geojsonData = !{JSON.stringify(content.features)};
      const map = L.map('items-map');
      L.tileLayer(
        'https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/pastel/EPSG:3857/{z}/{x}/{y}.png',
        {
          attribution:
            'Kaartgegevens &copy; <a href="https://www.kadaster.nl">Kadaster</a> | <a href="https://www.verbeterdekaart.nl">Verbeter de kaart</a>',
          minZoom: 6,
          maxZoom: 19
        }
      ).addTo(map);

      const items = new L.GeoJSON(geojsonData, {
        onEachFeature: function (feature, layer) {
          const id = feature.id !== undefined ? feature.id : '';
          const url = itemsPath + '/' + encodeURIComponent(id) + '?f=html';
          layer.bindPopup('<a href="' + url + '">' + String(id) + '</a>');
        }
      });

      if (typeof L.markerClusterGroup === 'function') {
        const markers = L.markerClusterGroup({
          disableClusteringAtZoom: 9,
          chunkedLoading: true,
          chunkInterval: 500
        });
        markers.addLayer(items);
        map.addLayer(markers);
      } else {
        items.addTo(map);
      }

      if (items.getBounds().isValid())
        map.fitBounds(items.getBounds());
