meta {
  name: Exec Sample features
  type: http
  seq: 11
}

post {
  url: {{serviceHost}}/processes/sampleFeatures/execution
  body: json
  auth: inherit
}

headers {
  Prefer: respond-async
}

body:json {
  {
    "inputs": {
      "uri": "https://ogcapi.delathouwer.me/geonovum/v1/collections/Neighborhoods/items"
    },
    "subscriber": {
      "successUri": ":serviceUrl/callback/:jobId?type=success",
      "inProgressUri": ":serviceUrl/callback/:jobId?type=inProgress",
      "failedUri": ":serviceUrl/callback/:jobId?type=failed"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
