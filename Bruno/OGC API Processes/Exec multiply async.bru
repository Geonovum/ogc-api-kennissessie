meta {
  name: Exec multiply async
  type: http
  seq: 17
}

post {
  url: {{serviceHost}}/processes/multiply/execution
  body: json
  auth: inherit
}

headers {
  Prefer: respond-async
}

body:json {
  {
    "inputs": {
      "number1": 3,
      "number2": 7
    },
    "subscriber": {
      "successUri": "{{subscriberUrl}}?type=success",
      "inProgressUri": "{{subscriberUrl}}?type=inProgress",
      "failedUri": "{{subscriberUrl}}?type=failed"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
